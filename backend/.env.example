# Realtouch Invoice backend environment template
# Copy this to backend/.env locally or enter the same values inside Namecheap cPanel Python App environment variables.
# Never commit real secrets to GitHub.

# Database
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=realtouch_invoice

# Security
JWT_SECRET=replace-with-a-long-secure-random-secret-minimum-32-characters
CORS_ORIGINS=https://invoice.yourdomain.com,https://www.invoice.yourdomain.com

# Product owner account - gives unlimited/owner access where supported by the app
OWNER_EMAIL=your-email@example.com

# Optional for first validation launch. Leave blank until ready.
STRIPE_API_KEY=
RESEND_API_KEY=
SENDER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
